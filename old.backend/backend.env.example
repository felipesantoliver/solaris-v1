services:
  - type: web
    name: solaris-backend
    env: node
    rootDir: backend
    buildCommand: npm install
    startCommand: node server.js
    envVars:
      - key: GROQ_API_KEY
        sync: false
      - key: DATABASE_URL
        sync: false
      - key: FRONTEND_URL
        sync: false
        # Chaves separadas para cada versão do Gemini
        GEMINI_FLASH_API_KEY=AIzaSy...
        GEMINI_PRO_API_KEY=AIzaSy...

# Demais variáveis
DATABASE_URL=postgresql://...
FRONTEND_URL=https://seu-frontend.com
PORT=3001