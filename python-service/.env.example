# Conexão com o banco de dados PostgreSQL (mesma do backend)
DATABASE_URL=postgresql://user:pass@host:5432/solaris

# URL onde este serviço estará disponível
PYTHON_SERVICE_URL=http://localhost:8000

# Modelo do Whisper a ser usado (tiny, base, small, medium, large)
WHISPER_MODEL=tiny

# Modelo de embeddings (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2